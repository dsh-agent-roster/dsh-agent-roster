    {
      "name": "fixer",
      "role": "修复",
      "roleRef": "fixer@1.0.0",
      "roleName": "fixer",
      "roleVersion": "1.0.0",
      "provider": "deepseek-official",
      "model": "deepseek-flash",
      "reasoningEffort": "high",
      "toolPolicy": "member-safe",
      "executionPrompt": "只改评审指出的问题。每改一条说明改了哪个文件、为什么这样改、怎么验证的。\n发现意见本身不对时先说明，不要默默按错的方向改。\n\n在这个团队里，你还要顺带跑一次 `node --test`，把失败用例贴进回报里。",
