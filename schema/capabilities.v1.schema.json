{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dsh-agent-roster/dsh-agent-roster/blob/main/schema/capabilities.v1.schema.json",
  "title": "DSH agent roster capability requirements",
  "description": "一份档案的能力要求（与 roster.{yaml,json} 同目录的 capabilities.{yaml,json}）：只声明「建这支队伍需要什么」，不承载能力本体。校验的权威实现是插件里的 lib/capabilities.js；本文件供编辑器与外部工具做提示，两者由 test/capabilities.test.js 对齐。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "roster"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "编辑器用的 schema 地址，插件不读它。"
    },
    "kind": {
      "const": "dsh-agent-roster-capabilities/v1"
    },
    "roster": {
      "$ref": "#/$defs/id",
      "description": "档案 id，必须与同目录的 roster 文件一致。"
    },
    "onMissing": {
      "enum": [
        "refuse",
        "degraded"
      ],
      "description": "证据源明确显示缺项时的行为：refuse（默认）拒绝生成建队参数；degraded 照常生成，但在每次核对里记成 degraded。"
    },
    "asOf": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "这份要求是照哪天的部署核对的。只收日期：时分秒会给人「一直新鲜」的错觉。"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "description": "只收有证据源的两类。模型路由可用性、插件版本、凭据指针、业务前置条件都没有证据源，写在这里只会变成又一份「看起来声明了」的假绿。",
      "properties": {
        "skills": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/skillRequirement"
          }
        },
        "toolPolicies": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/policyRequirement"
          }
        },
        "documents": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/documentRequirement"
          },
          "description": "要指到的具体文档（手册、runbook）。只核对在不在、内容对不对得上，永不拼进人设。"
        }
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 500
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "skillName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "policyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "skillRequirement": {
      "oneOf": [
        {
          "$ref": "#/$defs/skillName"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/skillName"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      ]
    },
    "policyRequirement": {
      "oneOf": [
        {
          "$ref": "#/$defs/policyId"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/policyId"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      ]
    },
    "documentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "相对档案库根的路径；不许 .. 或绝对路径。"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "可选：内容哈希，防漂移。"
        },
        "reason": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
