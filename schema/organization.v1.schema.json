{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/STofone/dsh-agent-roster/blob/main/schema/organization.v1.schema.json",
  "title": "DSH agent roster organization document",
  "description": "一座档案库的目录页：声明库里有哪几份档案、各自什么状态。校验的权威实现是 lib/organization.js；本文件供编辑器与外部工具提示，两者由 test/organization.test.js 对齐。",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "organization", "rosters"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "编辑器用的 schema 地址，插件不读它。"
    },
    "kind": { "const": "dsh-agent-roster-organization/v1" },
    "organization": {
      "$ref": "#/$defs/id",
      "description": "组织 id，同时是档案库根目录名。位置即身份。"
    },
    "title": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "license": { "type": "string", "maxLength": 120 },
    "homepage": { "type": "string", "maxLength": 200, "pattern": "^https?://\\S+$" },
    "maintainers": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "rosters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "description": "登记在案的档案。声明了却找不到目录会报错；目录在却没登记会告警。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": "string", "maxLength": 120 },
          "status": { "enum": ["active", "archived"] },
          "origin": { "type": "string", "maxLength": 120 },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" }
  }
}
